# Copier en .env (jamais commité). Ne mettre aucun secret ici.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PUBLIC_MODEL=gemini/gemini-2.5-flash
LLM_PUBLIC_FALLBACK=groq/openai/gpt-oss-120b
LLM_PRIVATE_MODEL=ollama/qwen2.5:7b
WHISPER_MODEL=groq/whisper-large-v3-turbo
ALLOW_CLOUD_FOR_NOTES=false
# Optionnels (routeur)
OLLAMA_API_BASE=http://localhost:11434
WHISPER_LOCAL_MODEL=small
LLM_ROUTER_DATA_DIR=data
# Délais max (secondes) d'UN appel HTTP au fournisseur ; valeurs par défaut si absent ou invalide : 60 et 120
LLM_TIMEOUT_SECONDS=60
WHISPER_TIMEOUT_SECONDS=120
# Vocaux : local uniquement tant que false
WHISPER_ALLOW_CLOUD=false
# Google (OAuth) : Gmail lecture seule + Calendar
GOOGLE_CLIENT_SECRET_FILE=./secrets/client_secret.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents
GOOGLE_CALENDAR_ID=primary
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Mails : false = Ollama local uniquement ; true = Gemini/Groq (Google peut réutiliser le contenu)
ALLOW_CLOUD_FOR_MAILS=false
# Boîte INSA (IMAP, lecture seule) : laissée vide = désactivée. Le mot de passe ne va QUE dans .env
INSA_IMAP_HOST=
INSA_IMAP_PORT=993
INSA_IMAP_USER=
INSA_IMAP_PASSWORD=
# dossiers lus, séparés par des virgules (un dossier non listé, ex. « Comptes et sécurité », n'est jamais lu)
INSA_IMAP_FOLDERS=INBOX
# expéditeurs jamais lus (morceaux d'adresse) ; vide = valeur par défaut (alertes MFA, codes Notion, sport-u)
INSA_IMAP_SKIP=
INSA_IMAP_DAYS=2
# newsletters : leurs mails ne donnent aucune info (morceaux d'adresse) ; vide = insa-communication
INFO_SKIP_SENDERS=
# Drive : dossier racine et classement des documents par le cloud (false = demande par boutons)
DRIVE_ROOT_NAME=Second cerveau
DRIVE_ENABLED=true
ALLOW_CLOUD_FOR_DOCS=false
# Notion : base Échéances (NOTION_TOKEN = secret de l intégration, à mettre dans .env seulement)
NOTION_TOKEN=
NOTION_DB_ID=
# Page Notion à cases (ex. checklist Security+) : une tâche se termine quand toutes ses notions y sont cochées.
# Lecture seule. Vide = désactivé. L'intégration Notion doit avoir accès à la page (⋯ → Connexions).
NOTION_CHECKLIST_PAGE=
# Quotas gratuits (estimations, a verifier dans Google AI Studio / console Groq) : sert a /quota et aux alertes a 80 %
GEMINI_DAILY_REQUESTS=20
GROQ_DAILY_REQUESTS=1000
GROQ_DAILY_TOKENS=200000
